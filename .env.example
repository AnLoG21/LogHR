# Docker compose maps Postgres→15432, Redis→16379.
# If you use local Windows PostgreSQL (as in README), keep 5433 and Redis 6379.
DATABASE_URL=postgresql://skillaz:skillaz@127.0.0.1:15432/skillaz?schema=public
REDIS_URL=redis://127.0.0.1:16379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skillaz
S3_REGION=us-east-1
STORAGE_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@loghr.local
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
SUPERJOB_TOKEN=
AVITO_TOKEN=
ZARPLATA_TOKEN=
HH_CHAT_TOKEN=
HH_USER_AGENT=LogHR/1.0 (noreply@loghr.local)
DADATA_TOKEN=
DADATA_API_KEY=
WORKER_TOKEN=
SMS_API_KEY=
SMS_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_PROVIDER=mock
PROACTION_WEBHOOK_SECRET=
PROACTION_AUTO_ALL=
METABASE_URL=http://localhost:3002
METABASE_EMAIL=admin@loghr.local
METABASE_PASSWORD=admin12345
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_NAME=skillaz
METABASE_DB_USER=skillaz
METABASE_DB_PASS=skillaz
BRAND_NAME=LogHR
BRAND_PRIMARY_COLOR=#0f2744
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Fallback, used when AI_* is empty or the primary provider fails
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Tried when OPENROUTER_MODEL fails or times out
OPENROUTER_FALLBACK_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HTTP(S) proxy for AI requests (OpenRouter returns 403 from some regions)
AI_PROXY_URL=
AI_TIMEOUT_MS=60000
