# Reverse proxy: /api/* -> NestJS (api:3001), everything else -> Next.js (web:3000).
# SITE_ADDRESS: domain (HTTPS) or ":80" for plain HTTP by IP.
# Optional custom TLS: create tls.caddy with:
#   tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
# Leave tls.caddy empty (or comments only) for Let's Encrypt auto (when SITE_ADDRESS is a public domain)
# or for plain HTTP (:80).
{$SITE_ADDRESS::80} {
	import tls.caddy
	encode gzip
	request_body /api/* {
		max_size 50MB
	}
	handle /api/* {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:3000
	}
}

# Extra sites (e.g. Metabase on :3443), server-local and gitignored: deploy/sites/*.caddy
import sites/*.caddy
