# Copy to deploy/.env on the server (server-setup.sh does it). Generate secrets with: openssl rand -hex 32
# Use hex/alphanumeric passwords: they are embedded into DATABASE_URL.

# --- Address ---
# PUBLIC_URL: what users open. SITE_ADDRESS: ":80" = plain HTTP by IP; a bare domain = HTTPS.
# Corporate certs: put PEM in deploy/certs/{fullchain,privkey}.pem and keep deploy/tls.caddy (see tls.caddy.example).
PUBLIC_URL=http://10.0.0.5
SITE_ADDRESS=:80
ACME_EMAIL=

# --- Core secrets (required) ---
POSTGRES_USER=loghr
POSTGRES_DB=loghr
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WORKER_TOKEN=
API_PORT=3001

# --- File storage: local volume by default; external S3: STORAGE_MODE=s3 + S3_* ---
STORAGE_MODE=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# --- First administrator (created once, only while the DB has no ADMIN) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Branding ---
BRAND_NAME=LogHR
BRAND_PRIMARY_COLOR=#0f2744

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Job boards ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_CHAT_TOKEN=
HH_USER_AGENT=LogHR/1.0 (admin@example.ru)
SUPERJOB_TOKEN=
AVITO_TOKEN=
ZARPLATA_TOKEN=

# --- AI (primary OpenAI-compatible → OpenRouter → heuristic) ---
# Primary: any OpenAI-compatible chat/completions API reachable from the server.
# Examples for RU: ProxyAPI (https://api.proxyapi.ru/openai/v1), YandexGPT OpenAI-compat,
# DeepSeek (https://api.deepseek.com), or a local gateway. Leave empty to skip.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional OpenRouter fallback (often blocked from RU without AI_PROXY_URL)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=openrouter/auto
AI_PROXY_URL=
AI_TIMEOUT_MS=120000

# --- Other integrations ---
DADATA_TOKEN=
SMS_API_KEY=
SMS_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_PROVIDER=mock
PROACTION_WEBHOOK_SECRET=

# --- Metabase (optional, needs ~1 GB RAM: 4 GB server recommended) ---
# COMPOSE_PROFILES=bi starts it on deploy; Caddy serves it via deploy/sites/metabase.caddy (see docs/DEPLOY.md).
# METABASE_PUBLIC_URL = browser link shown on /reports, e.g. https://hr.example.ru:3443
COMPOSE_PROFILES=
METABASE_URL=
METABASE_PUBLIC_URL=
METABASE_EMAIL=admin@loghr.local
METABASE_PASSWORD=
