# Copy to /opt/loghr/.env on the server. Generate secrets with: openssl rand -hex 32
# Use hex/alphanumeric passwords: they are embedded into DATABASE_URL.

# --- Domain / HTTPS (Caddy gets a Let's Encrypt certificate automatically) ---
DOMAIN=hr.example.ru
ACME_EMAIL=admin@example.ru

# --- Core secrets (required) ---
POSTGRES_USER=loghr
POSTGRES_DB=loghr
POSTGRES_PASSWORD=
MINIO_ROOT_USER=loghr
MINIO_ROOT_PASSWORD=
S3_BUCKET=loghr
S3_REGION=us-east-1
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WORKER_TOKEN=
API_PORT=3001

# --- First administrator (created once, only while the DB has no ADMIN) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Branding ---
BRAND_NAME=LogHR
BRAND_PRIMARY_COLOR=#0f2744

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Job boards ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_CHAT_TOKEN=
HH_USER_AGENT=LogHR/1.0 (admin@example.ru)
SUPERJOB_TOKEN=
AVITO_TOKEN=
ZARPLATA_TOKEN=

# --- AI (primary, then OpenRouter, then heuristic stub) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=openrouter/auto
AI_PROXY_URL=
AI_TIMEOUT_MS=120000

# --- Other integrations ---
DADATA_TOKEN=
SMS_API_KEY=
SMS_API_URL=
TELEPHONY_API_KEY=
TELEPHONY_PROVIDER=mock
PROACTION_WEBHOOK_SECRET=

# --- Metabase (optional: docker compose --profile bi up -d metabase) ---
METABASE_URL=
METABASE_EMAIL=
METABASE_PASSWORD=
